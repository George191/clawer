# Spider 配置文件
# 复制此文件为 .env 并根据需要修改

# 基础配置
SPIDER_LOG_LEVEL=INFO
SPIDER_OUTPUT_DIR=output
SPIDER_MAX_CONCURRENT_TASKS=5
SPIDER_CELERY_CONCURRENCY=5
SPIDER_CELERY_WORKER_REPLICAS=1
SPIDER_HTTP_PORT=80

# Standard FastAPI Web service: authentication, users, tenants, and RAG.
PROJECT_NAME=Spider Backend
API_V1_STR=/api/v1
ENVIRONMENT=local
SECRET_KEY=changethis
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
FIRST_SUPERUSER_PHONE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET_NAME=spider
AWS_S3_UPLOAD_PREFIX=uploads
MILVUS_HOST=localhost
MILVUS_PORT=19530

# HTTP 配置
SPIDER_HTTP_REQUEST_TIMEOUT=30.0
SPIDER_HTTP_DOWNLOAD_TIMEOUT=300.0
SPIDER_HTTP_MAX_RETRIES=3
SPIDER_HTTP_RETRY_BACKOFF=2.0
SPIDER_HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SPIDER_HTTP_PROXY=
# 如果遇到SSL错误，设置为false
SPIDER_HTTP_VERIFY_SSL=true

# AI Collect 浏览器渲染（Playwright Chromium / Chrome channel）
SPIDER_AI_BROWSER_ENABLED=true
SPIDER_AI_BROWSER_HEADLESS=true
# 留空时优先使用系统 Chrome/Chromium/Edge，找不到时回退到 Playwright 浏览器
SPIDER_AI_BROWSER_EXECUTABLE_PATH=
# 可选：chrome 或 msedge；设置后优先使用对应的 Playwright channel
SPIDER_AI_BROWSER_CHANNEL=
# 仅在隔离容器中确认需要时启用；默认保持 sandbox
SPIDER_AI_BROWSER_NO_SANDBOX=false

# 下载配置
SPIDER_DOWNLOAD_CHUNK_SIZE=8192
SPIDER_DOWNLOAD_ASSET_CONCURRENCY=64
SPIDER_DOWNLOAD_USE_PROXY=true

# MongoDB 配置
SPIDER_DB_URL=
SPIDER_DB_NAME=

# Redis 配置（DB 0: checkpoint，DB 1: 异步任务，DB 2: ETL）
SPIDER_REDIS_URL=

# MinIO 配置
SPIDER_MINIO_ENDPOINT=
# 前端访问地址（含协议），留空则使用 SPIDER_MINIO_ENDPOINT
SPIDER_MINIO_PUBLIC_ENDPOINT=
SPIDER_MINIO_ACCESS_KEY=
SPIDER_MINIO_SECRET_KEY=
SPIDER_MINIO_BUCKET=
SPIDER_BUSINESS_METADATA_MINIO_BUCKET=business-metadata
SPIDER_MINIO_SECURE=false
SPIDER_MINIO_MAX_WORKERS=32

# 下载规则缓存
SPIDER_DOWNLOAD_TEMPLATE_CACHE_SECONDS=60

# Kafka 配置
SPIDER_KAFKA_BROKERS=
SPIDER_KAFKA_TOPIC=
SPIDER_KAFKA_CLIENT_ID=
SPIDER_KAFKA_ENABLE_IDEMPOTENCE=true
SPIDER_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPIDER_KAFKA_SSL_CAFILE=
# 临时维护屏障：精确 topic 名的 JSON 数组，重启消费者生效；解除前先核对维护事件和位点。
SPIDER_KAFKA_PAUSED_TOPICS=[]
# 可选只读管理地址；部署环境填写实际 Kafka Connect 地址。
SPIDER_CDC_CONNECT_URL=
# 生产建议使用仅供 Debezium 的复制账号，与应用账号分离。
SPIDER_PG_CDC_URL=
# 整体迁移完成后使用 debezium；direct 用于受控回滚。
SPIDER_ETL_OUTPUT_MODE=debezium
SPIDER_MONGO_CDC_REPLICATION_FACTOR=3

# Elasticsearch 可选投影；空 URL/空表列表不会隐式启用。
SPIDER_ES_URL=
SPIDER_ES_USERNAME=
SPIDER_ES_PASSWORD=
SPIDER_ES_INDEX_PREFIX=spider_
SPIDER_ES_SYNCER_TABLES=
SPIDER_ES_SYNCER_CONFIG=
SPIDER_ES_SYNCER_BATCH_SIZE=100
SPIDER_ES_SYNCER_MAX_RETRIES=3
SPIDER_ES_SYNCER_RETRY_BACKOFF=2
SPIDER_ES_SYNCER_POLL_INTERVAL=60

# 反爬智能层配置
SPIDER_ANTI_CRAWL_ENABLED=false
SPIDER_TUNNEL_PROXY_URL=
SPIDER_PROXY_PRE_PROXY_URL=
SPIDER_PROXY_POOL_FILE=
SPIDER_PROXY_POOL_API_URLS=
SPIDER_PROXY_ROTATION=round_robin
SPIDER_PROXY_HEALTH_CHECK_URL=https://httpbin.org/ip
SPIDER_PROXY_MAX_FAILURES=3
SPIDER_REQUEST_DELAY_MIN=1.0
SPIDER_REQUEST_DELAY_MAX=3.0
SPIDER_DOMAIN_RATE_LIMIT={}
SPIDER_USER_AGENT_POOL_FILE=
SPIDER_REFERER_ENABLED=false
SPIDER_COOKIE_POOL_FILE=
SPIDER_IDENTITY_ROTATION_INTERVAL=0

# 调度器配置
SPIDER_SCHEDULER_ENABLED=false
# 默认不在生产订阅数据提交。启用仅限隔离环境中的上游/下游传输试点。
TRANSFER_SANDBOX_UPSTREAM_ENABLED=false
# 仅从本地沙箱真实正数手工提交中读取当前表对观察；默认关闭。
TRANSFER_SANDBOX_OBSERVED_LINEAGE_ENABLED=false
# 可选每日 UTC 时点必须与此前已验证的上游提交同时满足；默认关闭。
TRANSFER_SANDBOX_MIXED_UPSTREAM_ENABLED=false
# 每周 UTC 同步仍要求本地沙箱及既有 TRANSFER_SANDBOX_SCHEDULER_ENABLED；默认关闭。
TRANSFER_SANDBOX_WEEKLY_SCHEDULER_ENABLED=false
# 只检查本地沙箱已提交写入回执；默认不运行资产新鲜度检查。
TRANSFER_SANDBOX_FRESHNESS_ENABLED=false
# Explorer 只读取本地已审核资产的后台目录统计，不触发扫描或 ANALYZE。
TRANSFER_SANDBOX_COLLECTED_STATS_ENABLED=false
# 只查已审核的本地每日 UTC 同步结果；不启动作业或发送外部消息。
TRANSFER_SANDBOX_JOB_QUALITY_ENABLED=false
# 只取消仍在等待的单条本地每日 UTC 同步，不暂停整条调度。
TRANSFER_SANDBOX_JOB_CANCEL_ENABLED=false
# 指定合成表中数据时间与已核验提交时间的差距检查；默认关闭。
TRANSFER_SANDBOX_FIELD_FRESHNESS_ENABLED=false
# 固定合成表仅检查可证明的最低行数，不做全表计数。默认关闭。
TRANSFER_SANDBOX_MIN_ROWS_ENABLED=false
# Explorer 索引保护试点仅限固定本地合成表，默认关闭。
ONTOLOGY_INDEX_PREVIEW_SANDBOX_ENABLED=false
# 已审核普通表的索引验证 ID 抽样，独立于普通筛选；默认关闭。
ONTOLOGY_EXPLORER_INDEXED_SAMPLE_ENABLED=false
# 环回数据库身份标记与最多三个精确物理绑定由隔离部署预置。
ONTOLOGY_EXPLORER_INDEXED_SAMPLE_DATABASE_MARKER=
ONTOLOGY_EXPLORER_INDEXED_SAMPLE_ALLOWLIST=[]
# 批量同步试点仅限显式 local 隔离环境。定时执行复用现有 Celery；
# API 与 worker 必须共享同一个已验证的环回网络环境。不要在默认 Compose 启用。
BATCH_SYNC_SANDBOX_ENABLED=false
# 已审核的 ID 区间快照，只限固定隔离源和目标。默认关闭。
BATCH_SYNC_RANGE_SNAPSHOT_ENABLED=false
BATCH_SYNC_SANDBOX_SCHEDULER_ENABLED=false
# 已保存 PostgreSQL 源身份验证仅用于本地隔离批量同步。
# 期望标记由隔离环境单独配置，不提交真实值。
BATCH_SYNC_SOURCE_IDENTITY_ENABLED=false
# 在隔离环境中管理已保存 PostgreSQL 连接的暂停和恢复；默认不提供新的状态变更。
ONTOLOGY_POSTGRES_SOURCE_PAUSE_ENABLED=false
BATCH_SYNC_SOURCE_IDENTITY_MARKER=
# 按源提交批次增量同步，只允许已审核的本地合成流和专用目标。
BATCH_SYNC_INCREMENTAL_ENABLED=false
# 本体增量回放试点：仅固定本地合成夹具，默认关闭，不影响生产 CDC。
CDC_SANDBOX_ENABLED=false
# 独立的本地合成推送收件箱：不会注册在普通 Web 服务或启动 CDC。
# 验签公钥和数据库标记在隔离部署单独配置，不提交实际值。
PUSH_INBOX_SANDBOX_ENABLED=false
# Optional local admin control of new signed arrivals only (not receipt replay or Apply).
PUSH_INBOX_SANDBOX_INTAKE_CONTROL_ENABLED=false
# 另行审核专用本地合成目标后，才允许手工应用；不会自行运行。
PUSH_INBOX_SANDBOX_APPLY_ENABLED=false
PUSH_INBOX_SANDBOX_PUBLIC_KEY=
PUSH_INBOX_SANDBOX_DATABASE_MARKER=
# 只记录已确认的合成 CDC 目标版本；历史不回填，默认关闭。
CDC_SANDBOX_VERSIONS_ENABLED=false
# 只在明确开启的本地合成 CDC 版本上试算，不写输出数据。
ONTOLOGY_SANDBOX_PIPELINE_ENABLED=false
# Builder 双输入按 ID 匹配只支持同一合成流的已封存版本；默认关闭。
ONTOLOGY_SANDBOX_PIPELINE_MATCH_ENABLED=false
# 仅写入独立的本地合成 Builder 输出存储，默认不启用提交。
ONTOLOGY_SANDBOX_PIPELINE_OUTPUT_ENABLED=false
# 本地合成资产标记继承试点，默认关闭；不改变生产或外发授权。
ONTOLOGY_SYNTHETIC_GOVERNANCE_ENABLED=false
# 独立接收方的本地合成交接资格预检；不发送数据。默认关闭。
ONTOLOGY_SANDBOX_HANDOFF_ENABLED=false
# 独立执行授权才能在同一隔离库内复制；资格预检不写数据。默认关闭。
ONTOLOGY_SANDBOX_HANDOFF_COPY_ENABLED=false
ONTOLOGY_SANDBOX_HANDOFF_COPY_DATABASE_MARKER=
ONTOLOGY_SANDBOX_HANDOFF_COPY_PHYSICAL_DIGEST=
ONTOLOGY_SANDBOX_HANDOFF_COPY_GRANTS={}
ONTOLOGY_SANDBOX_HANDOFF_SINK_GENERATION=
ONTOLOGY_SANDBOX_HANDOFF_SINK_CLEARANCE=
ONTOLOGY_SANDBOX_HANDOFF_SINK_GRANTS={}
# 表导出只允许隔离环境中的预置合成数据与数值环回接收端。
# 默认关闭；源/接收端标识、接收库和专用凭证由隔离部署另行配置。
TABLE_EXPORT_SANDBOX_ENABLED=false
# 允许单个已审核合成接收端采用只追加、冲突整批拒绝。默认关闭。
TABLE_EXPORT_APPEND_ENABLED=false
# 第二个环回接收端独立审核；部署凭证轮换时更新独立配置版本。
TABLE_EXPORT_SECONDARY_ENABLED=false
TABLE_EXPORT_SECONDARY_RECEIVER_HOST=
TABLE_EXPORT_SECONDARY_RECEIVER_PORT=
TABLE_EXPORT_SECONDARY_RECEIVER_DATABASE=
TABLE_EXPORT_SECONDARY_RECEIVER_USERNAME=
TABLE_EXPORT_SECONDARY_RECEIVER_PASSWORD=
TABLE_EXPORT_SECONDARY_RECEIVER_MARKER=
TABLE_EXPORT_SECONDARY_RECEIVER_TLS=false
TABLE_EXPORT_SECONDARY_CONFIG_REVISION=
SPIDER_RATE_LIMIT_ENABLED=false
SPIDER_DOMAIN_RATE_LIMIT_CONFIG={}
SPIDER_FALLBACK_ENABLED=false
SPIDER_FALLBACK_MAX_PROXY_FAILURES=5
SPIDER_FALLBACK_COOLDOWN_SECONDS=300

# 模板引擎配置
SPIDER_JINJA2_ENABLED=false
SPIDER_CONDITIONAL_FIELDS_ENABLED=false
SPIDER_PRE_HOOKS_ENABLED=false

# Postgres ETL 配置
SPIDER_PG_URL=postgresql+asyncpg://postgres:postgres@localhost:32775/spider_etl
SPIDER_PG_POOL_MIN=2
SPIDER_PG_POOL_MAX=10

# ETL Kafka Topics
SPIDER_ETL_RAW_TOPIC=
SPIDER_ETL_RDS_TOPIC=
SPIDER_ETL_ODS_TOPIC=
SPIDER_ETL_ADS_TOPIC=
SPIDER_ETL_TASK_TOPIC=
SPIDER_ETL_DWD_TOPIC=
SPIDER_ETL_GRAPH_TOPIC=
SPIDER_ETL_DWS_TOPIC=
SPIDER_ETL_DIM_TOPIC=

# ETL Consumer Groups
SPIDER_ETL_RDS_CONSUMER_GROUP=spider-rds-group
SPIDER_ETL_ODS_CONSUMER_GROUP=spider-ods-group
SPIDER_ETL_ADS_CONSUMER_GROUP=spider-ads-group
SPIDER_ETL_TASK_CONSUMER_GROUP=spider-task-group
SPIDER_ETL_DWD_CONSUMER_GROUP=spider-dwd-group
SPIDER_ETL_GRAPH_CONSUMER_GROUP=spider-graph-group
SPIDER_ETL_DWS_CONSUMER_GROUP=spider-dws-group
SPIDER_ETL_DIM_CONSUMER_GROUP=spider-dim-group
