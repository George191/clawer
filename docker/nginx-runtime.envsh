#!/bin/sh

for deployment_domain in "${FRONTEND_DOMAIN_SUFFIX:?FRONTEND_DOMAIN_SUFFIX is required}" "${BACKEND_DOMAIN_SUFFIX:?BACKEND_DOMAIN_SUFFIX is required}"; do
    case "$deployment_domain" in
        *[!A-Za-z0-9.-]*|.*|*.|*..*|'')
            echo "Invalid deployment domain: $deployment_domain" >&2
            exit 1
            ;;
    esac
    printf '%s\n' "$deployment_domain" | LC_ALL=C awk -F. '
        length($0) > 253 || NF < 2 { exit 1 }
        { for (i = 1; i <= NF; i++) {
            if (length($i) > 63 || $i !~ /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$/) exit 1
        } }
    ' || { echo "Invalid deployment domain: $deployment_domain" >&2; exit 1; }
done

case "${SPIDER_HTTPS_PORT:?SPIDER_HTTPS_PORT is required}" in
    *[!0-9]*|'') echo "SPIDER_HTTPS_PORT must be a port number" >&2; exit 1 ;;
esac
if [ "$SPIDER_HTTPS_PORT" -lt 1 ] || [ "$SPIDER_HTTPS_PORT" -gt 65535 ]; then
    echo "SPIDER_HTTPS_PORT must be between 1 and 65535" >&2
    exit 1
fi

HTTPS_REDIRECT_PORT=""
if [ "$SPIDER_HTTPS_PORT" -ne 443 ]; then
    HTTPS_REDIRECT_PORT=":$SPIDER_HTTPS_PORT"
fi
export HTTPS_REDIRECT_PORT

printf 'window.__APP_CONFIG__ = {"backendDomainSuffix":"%s", "httpsPort":"%s", "frontendDomainSuffix":"%s"};\n' \
    "$BACKEND_DOMAIN_SUFFIX" "$SPIDER_HTTPS_PORT" "$FRONTEND_DOMAIN_SUFFIX" > /etc/nginx/runtime-config.js
