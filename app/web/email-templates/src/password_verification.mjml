<mjml>
  <mj-head>
    <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" /><mj-text color="#3c4043" font-size="15px" line-height="24px" /></mj-attributes>
  </mj-head>
  <mj-body background-color="#f7f9fc" width="640px">
    <mj-section padding="48px 24px 20px"><mj-column><mj-image align="center" width="48px" height="48px" src="{{ logo_url }}" alt="Asiral Helio" padding="0 0 14px" /><mj-text align="center" color="#152238" font-size="17px" font-weight="700" letter-spacing="2px" padding="0">ASIRAL HELIO</mj-text><mj-text align="center" color="#7b8798" font-size="10px" font-weight="700" letter-spacing="2px" padding="8px 0 0">UNIFIED DATA INTELLIGENCE</mj-text></mj-column></mj-section>
    <mj-section background-color="#ffffff" border="1px solid #e4e9f0" border-radius="14px" padding="52px 56px 46px">
      <mj-column>
        <mj-text align="center" color="#202124" font-size="28px" font-weight="600" line-height="36px" padding="0 0 16px">Verify it’s you</mj-text>
        <mj-text align="center" color="#5f6368" padding="0 0 34px">We received a request to reset the password for <strong>{{ email }}</strong>. Enter this code in Asiral Helio to continue.</mj-text>
        <mj-text align="center" background-color="#f4f8ff" border-radius="10px" color="#0878d1" font-family="Courier New, monospace" font-size="38px" font-weight="700" letter-spacing="12px" line-height="48px" padding="22px 12px">{{ code }}</mj-text>
        <mj-text align="center" color="#5f6368" font-size="13px" padding="28px 0 0">This code expires in {{ valid_minutes }} minutes.</mj-text>
        <mj-divider border-color="#e8eaed" border-width="1px" padding="36px 0 24px" />
        <mj-text align="center" color="#7b8798" font-size="12px" line-height="20px" padding="0">If you didn’t request this, you can safely ignore this email. Never share this code—Asiral Helio support will never ask for it.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 24px 44px"><mj-column><mj-text align="center" color="#9aa3af" font-size="11px" line-height="18px" padding="0">Automated security message from Asiral Helio<br />Secure identity · Tenant isolation · Audited access</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
