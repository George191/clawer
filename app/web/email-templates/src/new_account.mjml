<mjml>
  <mj-head>
    <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" /><mj-text color="#3c4043" font-size="15px" line-height="24px" /></mj-attributes>
  </mj-head>
  <mj-body background-color="#f7f9fc" width="640px">
    <mj-section padding="48px 24px 20px"><mj-column><mj-image align="center" width="48px" height="48px" src="{{ logo_url }}" alt="Asiral Helio" padding="0 0 14px" /><mj-text align="center" color="#152238" font-size="17px" font-weight="700" letter-spacing="2px" padding="0">ASIRAL HELIO</mj-text><mj-text align="center" color="#7b8798" font-size="10px" font-weight="700" letter-spacing="2px" padding="8px 0 0">UNIFIED DATA INTELLIGENCE</mj-text></mj-column></mj-section>
    <mj-section background-color="#ffffff" border="1px solid #e4e9f0" border-radius="14px" padding="52px 56px 46px">
      <mj-column>
        <mj-text align="center" color="#202124" font-size="28px" font-weight="600" line-height="36px" padding="0 0 16px">Your workspace is ready</mj-text>
        <mj-text align="center" color="#5f6368" padding="0 0 30px">Welcome to Asiral Helio. Your account has been created for the unified data intelligence platform.</mj-text>
        <mj-text background-color="#f6f8fb" border-radius="10px" color="#5f6368" font-size="13px" line-height="22px" padding="20px 24px"><span style="color:#7b8798">Account</span><br /><strong style="color:#202124">{{ username }}</strong><br /><br /><span style="color:#7b8798">Temporary password</span><br /><strong style="color:#202124">{{ password }}</strong></mj-text>
        <mj-button align="center" background-color="#0878d1" border-radius="6px" color="#ffffff" font-size="15px" font-weight="700" href="{{ link }}" inner-padding="14px 28px" padding="30px 0 22px">Open Asiral Helio</mj-button>
        <mj-text align="center" color="#7b8798" font-size="12px" line-height="20px" padding="0">For your security, sign in and replace the temporary password immediately. Do not forward this email.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 24px 44px"><mj-column><mj-text align="center" color="#9aa3af" font-size="11px" line-height="18px" padding="0">Asiral Helio · Unified Data Intelligence Platform<br />Data collection · Lakehouse · ETL · AI · Geospatial</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
