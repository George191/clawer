<mjml>
  <mj-head>
    <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" /><mj-text color="#3c4043" font-size="15px" line-height="24px" /></mj-attributes>
  </mj-head>
  <mj-body background-color="#f7f9fc" width="640px">
    <mj-section padding="48px 24px 20px"><mj-column><mj-image align="center" width="48px" height="48px" src="{{ logo_url }}" alt="Asiral Helio" padding="0 0 14px" /><mj-text align="center" color="#152238" font-size="17px" font-weight="700" letter-spacing="2px" padding="0">ASIRAL HELIO</mj-text><mj-text align="center" color="#7b8798" font-size="10px" font-weight="700" letter-spacing="2px" padding="8px 0 0">SYSTEM COMMUNICATIONS</mj-text></mj-column></mj-section>
    <mj-section background-color="#ffffff" border="1px solid #e4e9f0" border-radius="14px" padding="52px 56px 46px">
      <mj-column>
        <mj-text align="center" color="#202124" font-size="28px" font-weight="600" line-height="36px" padding="0 0 16px">Email delivery is working</mj-text>
        <mj-text align="center" color="#5f6368" padding="0 0 28px">This test message from <strong>{{ project_name }}</strong> was delivered successfully to <strong>{{ email }}</strong>.</mj-text>
        <mj-text align="center" background-color="#eef8f4" border-radius="10px" color="#13795b" font-size="13px" font-weight="700" letter-spacing="1px" padding="16px">DELIVERY CHANNEL VERIFIED</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 24px 44px"><mj-column><mj-text align="center" color="#9aa3af" font-size="11px" line-height="18px" padding="0">Asiral Helio · System-generated test message</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
