{
  "description": "Guardrails for user-triggered AI collect workflows in the frontend.",
  "url_rules": {
    "allowed_schemes": ["http", "https"],
    "blocked_exact_hosts": ["localhost", "127.0.0.1", "0.0.0.0", "::1"],
    "blocked_prefix_hosts": ["10.", "192.168."],
    "blocked_172_range": [16, 31]
  },
  "limits": {
    "max_template_pages": 100,
    "max_dry_run_limit": 100,
    "max_generated_adapter_lines": 500,
    "max_generated_template_bytes": 65536,
    "max_generated_adapter_bytes": 65536,
    "max_generated_fields": 100,
    "max_preview_html_bytes": 120000
  },
  "agent_output": {
    "model_path": "models/Qwen/2.5-0.5B-Instruct",
    "allowed_artifacts": ["template_yaml", "adapter_python"],
    "allowed_template_path": "templates/{name}.yaml",
    "allowed_adapter_path": "app/adapters/{name}.py",
    "allow_extra_files": false,
    "allow_commands": false,
    "allow_network_from_generated_code": false
  },
  "adapter_rules": {
    "forbidden_patterns": [
      "eval(",
      "child_process",
      "process.env",
      "/etc/",
      "/proc/",
      "/.ssh/"
    ]
  },
  "publish_scope": {
    "allowed_paths": [
      "templates/*.yaml",
      "app/adapters/*.py"
    ],
    "forbidden_actions": [
      "modify_existing_templates",
      "modify_existing_adapters",
      "delete_existing_assets"
    ]
  }
}
